{
  "name": "cantina-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.26",
    "expo-font": "~58.0.11",
    "expo-status-bar": "~58.0.5",
    "express": "^5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "app": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "node --test --disable-warning=ExperimentalWarning \"server/tests/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "auditoria": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/scripts/audit-log.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "private": true
}
