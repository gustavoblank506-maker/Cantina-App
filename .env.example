# Copie este arquivo para .env e preencha. O .env fica fora do git.

# Conta da atendente, criada na primeira vez que o servidor sobe.
# Escolha uma senha forte (mínimo 8 caracteres). Não existe senha padrão.
ATTENDANT_USERNAME=atendente
ATTENDANT_NAME=Atendente
ATTENDANT_PASSWORD=

# Porta do servidor
PORT=3000

# Arquivo do banco SQLite (criado automaticamente)
DATABASE_FILE=data/cantina.db

# Duração da sessão, em horas
SESSION_HOURS=8

# Lista de matrículas autorizadas a criar conta (uma por linha). Fica em data/, fora do git.
# Sem o arquivo, qualquer pessoa pode criar conta de aluno (o servidor avisa ao subir).
# STUDENT_LIST_FILE=data/matriculas.txt

# Dias que o log de auditoria guarda os registros antes de apagar (LGPD).
# AUDIT_LOG_DAYS=90

# Fuso da escola para o resumo do dia. Alagoinhas (BA): -3.
# UTC_OFFSET_HOURS=-3

# Ao publicar na internet, defina NODE_ENV=production no serviço de hospedagem:
# isso liga o cookie Secure (só HTTPS) e o HSTS.

# Atrás de um proxy (Render, Railway...), informe quantos proxies há na frente,
# para o limite de tentativas enxergar o IP real de quem acessa.
# TRUST_PROXY=1

# Origens que podem chamar a API de outro endereço. Em desenvolvimento,
# o padrão já libera o Expo (http://localhost:8081).
# CORS_ORIGIN=http://localhost:8081

# Para testar no celular com Expo Go, crie o arquivo .env.development.local
# (também fora do git) com o IP do computador na rede:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
